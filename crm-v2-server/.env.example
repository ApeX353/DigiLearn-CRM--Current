# ---------------------------------------------------------------------------
# DigiLearn CRM v2 — Server environment template
#
# Copy this file to `.env` and fill in the values. Variable names MUST match
# what `src/database/datasource.ts` and the `@nestjs/config` module read at
# runtime. Previously `.env.example` listed DB_HOST/DB_USERNAME/etc. while
# the code actually read DATABASE_HOST/DATABASE_USERNAME — this template has
# been aligned to the code.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
# Port the Nest HTTP server listens on. The legacy variable name
# `SMS_PORT` is still honoured as a fallback but new deployments
# should use `PORT`.
PORT=3001

# CORS — comma-separated list of allowed origins (exact match). Your
# Vite dev origin is added automatically.
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Database (PostgreSQL)
DB_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=digilearn_crm
# `true` lets TypeORM auto-sync entity changes. Turn OFF in production
# and use migrations (`npx typeorm migration:run`) instead.
DB_SYNCHRONIZE=true
DB_LOGGING=false
# Migrations run automatically at boot when NODE_ENV=production. Set
# true to also run them at boot in dev (default: run manually with
# `npm run migration:run`).
DB_RUN_MIGRATIONS=false
# Baseline seeds (roles/permissions + bootstrap admin) also run at boot
# when NODE_ENV=production; set true to run them at boot in dev too.
# All seeds are idempotent.
DB_RUN_SEEDS=false
# Bootstrap admin (only used the first time, on a database with no
# admin user). If ADMIN_PASSWORD is unset a random password is
# generated and printed once to the boot log, and the account is
# forced to change it on first login.
# ADMIN_EMAIL=admin@digilearn.com
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User

# JWT
JWT_SECRET_TOKEN=change-this-in-production-to-a-long-random-string
# Access-token lifetime in days.
JWT_EXPIRATION=7

# MCP / API-key guard
CRM_API_KEY=change-this-in-production

# Email (optional — SMTP for password reset, verification, notifications)
EMAIL_FROM=noreply@digilearn.com
# Required before storing live per-user mailbox passwords. Use a long random
# value and keep it stable; changing it invalidates saved mailbox credentials.
# USER_EMAIL_CREDENTIALS_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# WhatsApp (optional)
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_ID=

# File storage (optional — Vercel Blob)
# BLOB_READ_WRITE_TOKEN=
