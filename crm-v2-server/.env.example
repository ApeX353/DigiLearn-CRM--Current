# Application Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=
DB_LOGGING=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=15m

# Security Configuration
# Maximum failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# Refresh token expiry in days
REFRESH_TOKEN_EXPIRY_DAYS=30

# Password reset token expiry in hours
PASSWORD_RESET_EXPIRY_HOURS=1

# Email Verification Configuration
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# 2FA Configuration
TWO_FACTOR_ISSUER=DigiLearn School

# Email Configuration (for password reset, verification, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@example.com

# Optional: Redis Configuration (for session storage, caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: File Upload Configuration
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=uploads

# Application URLs
APP_URL=http://localhost:3000

# Email Notifications
EMAIL_FROM=noreply@digilearn.com
SUPPORT_EMAIL=support@digilearn.com

# SMTP Email Provider (Use this OR SendGrid, not both)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid Email Provider (Alternative to SMTP)
# SENDGRID_API_KEY=your-sendgrid-api-key

# SMS Configuration - Twilio (Use this OR AWS SNS, not both)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SMS Configuration - AWS SNS (Alternative to Twilio)
# AWS_SNS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

