{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM oven/bun:1",
    "WORKDIR /usr/src/app",
    "",
    "# Copy package files. The lockfile is `bun.lock` (text format, Bun >= 1.2).",
    "# The previous glob `bun.lockb*` never matched it, so --frozen-lockfile",
    "# failed the image build.",
    "COPY package.json bun.lock* ./",
    "",
    "# Install all dependencies (including dev dependencies).",
    "# NOT --frozen-lockfile: the committed bun.lock predates the removal of",
    "# mysql2 from package.json, so a frozen install refuses to run. Re-freeze",
    "# after regenerating bun.lock with `bun install` on a machine that has bun.",
    "RUN bun install",
    "",
    "# Copy all project files",
    "COPY . .",
    "",
    "RUN bun run build",
    "",
    "ARG NODE_ENV=production",
    "ARG PORT",
    "ARG JWT_SECRET_TOKEN",
    "ARG JWT_REFRESH_TOKEN",
    "ARG JWT_EXPIRATION",
    "ARG JWT_REFRESH_EXPIRATION",
    "ARG DATABASE_HOST",
    "ARG DATABASE_PORT",
    "ARG DATABASE_USERNAME",
    "ARG DATABASE_PASSWORD",
    "ARG DATABASE_NAME",
    "ARG SMS_PORT",
    "ARG CORS_CREDENTIALS",
    "ARG CORS_ORIGIN",
    "ARG EMAIL_FROM",
    "ARG SMTP_HOST",
    "ARG SMTP_PORT",
    "ARG SMTP_SECURE",
    "ARG SMTP_USER",
    "ARG SMTP_PASS",
    "ARG CRM_API_KEY",
    "ARG USER_EMAIL_CREDENTIALS_KEY",
    "ARG BLOB_READ_WRITE_TOKEN",
    "",
    "ENV NODE_ENV=$NODE_ENV",
    "ENV PORT=$PORT",
    "ENV JWT_SECRET_TOKEN=$JWT_SECRET_TOKEN",
    "ENV JWT_REFRESH_TOKEN=$JWT_REFRESH_TOKEN",
    "ENV JWT_EXPIRATION=$JWT_EXPIRATION",
    "ENV JWT_REFRESH_EXPIRATION=$JWT_REFRESH_EXPIRATION",
    "ENV DATABASE_HOST=$DATABASE_HOST",
    "ENV DATABASE_PORT=$DATABASE_PORT",
    "ENV DATABASE_USERNAME=$DATABASE_USERNAME",
    "ENV DATABASE_PASSWORD=$DATABASE_PASSWORD",
    "ENV DATABASE_NAME=$DATABASE_NAME",
    "ENV SMS_PORT=$SMS_PORT",
    "ENV CORS_CREDENTIALS=$CORS_CREDENTIALS",
    "ENV CORS_ORIGIN=$CORS_ORIGIN",
    "ENV EMAIL_FROM=$EMAIL_FROM",
    "ENV SMTP_HOST=$SMTP_HOST",
    "ENV SMTP_PORT=$SMTP_PORT",
    "ENV SMTP_SECURE=$SMTP_SECURE",
    "ENV SMTP_USER=$SMTP_USER",
    "ENV SMTP_PASS=$SMTP_PASS",
    "ENV CRM_API_KEY=$CRM_API_KEY",
    "ENV USER_EMAIL_CREDENTIALS_KEY=$USER_EMAIL_CREDENTIALS_KEY",
    "ENV BLOB_READ_WRITE_TOKEN=$BLOB_READ_WRITE_TOKEN",
    "",
    "# The app listens on PORT (falls back to SMS_PORT, then 3001 — see src/main.ts)",
    "EXPOSE 3001",
    "",
    "CMD [\"bun\", \"dist/main\"]"
  ]
}
