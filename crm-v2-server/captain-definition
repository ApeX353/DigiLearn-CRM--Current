{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM oven/bun:1",
    "WORKDIR /usr/src/app",
    "",
    "# Copy package files",
    "COPY package.json bun.lockb* ./",
    "",
    "# Install all dependencies (including dev dependencies)",
    "RUN bun install --frozen-lockfile",
    "",
    "# Copy all project files",
    "COPY . .",
    "",
    "RUN bun run build",
    "",
    "ARG JWT_SECRET_TOKEN",
    "ARG JWT_REFRESH_TOKEN",
    "ARG JWT_EXPIRATION",
    "ARG JWT_REFRESH_EXPIRATION",
    "ARG DATABASE_HOST",
    "ARG DATABASE_PORT",
    "ARG DATABASE_USERNAME",
    "ARG DATABASE_PASSWORD",
    "ARG DATABASE_NAME",
    "ARG SMS_PORT",
    "ARG CORS_CREDENTIALS",
    "ARG CORS_ORIGIN",
    "ARG SMTP_HOST",
    "ARG SMTP_PORT",
    "ARG SMTP_SECURE",
    "ARG SMTP_USER",
    "ARG SMTP_PASS",
    "ARG BLOB_READ_WRITE_TOKEN",
    "",
    "ENV JWT_SECRET_TOKEN=$JWT_SECRET_TOKEN",
    "ENV JWT_REFRESH_TOKEN=$JWT_REFRESH_TOKEN",
    "ENV JWT_EXPIRATION=$JWT_EXPIRATION",
    "ENV JWT_REFRESH_EXPIRATION=$JWT_REFRESH_EXPIRATION",
    "ENV DATABASE_HOST=$DATABASE_HOST",
    "ENV DATABASE_PORT=$DATABASE_PORT",
    "ENV DATABASE_USERNAME=$DATABASE_USERNAME",
    "ENV DATABASE_PASSWORD=$DATABASE_PASSWORD",
    "ENV DATABASE_NAME=$DATABASE_NAME",
    "ENV SMS_PORT=$SMS_PORT",
    "ENV CORS_CREDENTIALS=$CORS_CREDENTIALS",
    "ENV CORS_ORIGIN=$CORS_ORIGIN",
    "ENV SMTP_HOST=$SMTP_HOST",
    "ENV SMTP_PORT=$SMTP_PORT",
    "ENV SMTP_SECURE=$SMTP_SECURE",
    "ENV SMTP_USER=$SMTP_USER",
    "ENV SMTP_PASS=$SMTP_PASS",
    "ENV BLOB_READ_WRITE_TOKEN=$BLOB_READ_WRITE_TOKEN",
    "# Expose the port Nest.js dev server runs on",
    "EXPOSE 3000",
    "",
    "# Run in development mode",
    "CMD [\"bun\", \"dist/main\"]"
  ]
}
